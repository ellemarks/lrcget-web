# Copy to .env and adjust. Used by docker-compose.yml.

# Your music folder on the host (required)
LRCGET_MUSIC_DIR=/path/to/your/music

# Password for the web login (required); the username defaults to "lrcget"
LRCGET_PASSWORD=
#LRCGET_USERNAME=lrcget

# User and group that own your music files (see `id`)
LRCGET_UID=1000
LRCGET_GID=1000

# Port on the host
LRCGET_PORT=3000
